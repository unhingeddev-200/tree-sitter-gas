{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gas",
      "camelcase": "Gas",
      "title": "Gas",
      "scope": "source.gas",
      "file-types": [
        "gas",
        "s",
        "S",
        "asm",
        "inc"
      ],
      "injection-regex": "^gas$",
      "class-name": "TreeSitterGas"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "grammar for gnu assembler",
    "authors": [
      {
        "name": "unhingeddev-200",
        "email": "unhingeddev@proton.me"
      }
    ],
    "links": {
      "repository": "https://github.com/unhingeddev-200/tree-sitter-gas.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
